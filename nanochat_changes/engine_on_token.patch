+@torch.inference_mode()
+def apply_repetition_penalty(logits, seen_token_ids, penalty):
+    """Down-weight tokens already produced. penalty=1.0 is a no-op. >1 discourages repeats."""
+    if penalty is None or penalty == 1.0:
+        return logits
+    logits = logits.clone()
+    for row, ids in enumerate(seen_token_ids):
+        if not ids:
+            continue
+        uniq = torch.tensor(list(set(ids)), device=logits.device, dtype=torch.long)
+        selected = logits[row, uniq]
+        logits[row, uniq] = torch.where(selected > 0, selected / penalty, selected * penalty)
+    return logits
+
